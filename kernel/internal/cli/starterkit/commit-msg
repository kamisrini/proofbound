#!/bin/sh
# Installed by `proofbound init`: a commit that changes code must claim the spec change it implements.
# `proofbound task start <change>` makes the prepare-commit-msg hook add the claim for you.
command -v proofbound >/dev/null 2>&1 || { echo "proofbound: not on PATH; install it (the commit-msg hook needs it)" >&2; exit 1; }
proofbound hook commit-msg "$1"
rc=$?
# Exit 2 is a usage error: a proofbound older than this hook, which has no `hook` command.
[ "$rc" -eq 2 ] && echo "proofbound: $(command -v proofbound) is too old for this hook; install the latest release" >&2
exit "$rc"
